{
  "schemaVersion": "1.0",
  "thresholds": {
    "minimumRecall": 1,
    "minimumPrecision": 1
  },
  "cases": [
    {
      "id": "github-classic",
      "lineTemplate": "GITHUB_TOKEN={value}",
      "value": { "prefix": "ghp_", "body": "A1b2", "repeat": 9 },
      "expectedRuleId": "github-token"
    },
    {
      "id": "github-fine-grained",
      "lineTemplate": "GITHUB_TOKEN={value}",
      "value": { "prefix": "github_pat_", "body": "C3d4", "repeat": 20 },
      "expectedRuleId": "github-token"
    },
    {
      "id": "gitlab",
      "lineTemplate": "GITLAB_TOKEN={value}",
      "value": { "prefix": "glpat-", "body": "E5f6", "repeat": 6 },
      "expectedRuleId": "gitlab-token"
    },
    {
      "id": "slack",
      "lineTemplate": "SLACK_TOKEN={value}",
      "value": { "prefix": "xoxb-", "body": "1234567890-", "repeat": 3 },
      "expectedRuleId": "slack-token"
    },
    {
      "id": "stripe-live",
      "lineTemplate": "STRIPE_SECRET={value}",
      "value": { "prefix": "sk_live_", "body": "G7h8", "repeat": 6 },
      "expectedRuleId": "stripe-live-secret-key"
    },
    {
      "id": "npm",
      "lineTemplate": "NPM_TOKEN={value}",
      "value": { "prefix": "npm_", "body": "J9k0", "repeat": 9 },
      "expectedRuleId": "npm-access-token"
    },
    {
      "id": "pypi",
      "lineTemplate": "PYPI_TOKEN={value}",
      "value": {
        "prefix": "pypi-AgEIcHlwaS5vcmc",
        "body": "L1m2",
        "repeat": 10
      },
      "expectedRuleId": "pypi-upload-token"
    },
    {
      "id": "sendgrid",
      "lineTemplate": "SENDGRID_KEY={value}",
      "value": {
        "prefix": "SG.",
        "body": "N3p4",
        "repeat": 4,
        "suffix": ".Q5r6Q5r6Q5r6Q5r6Q5r6Q5r6Q5r6Q5r6"
      },
      "expectedRuleId": "sendgrid-api-key"
    },
    {
      "id": "google-api",
      "lineTemplate": "GOOGLE_API_KEY={value}",
      "value": { "prefix": "AIza", "body": "S7t8U9v", "repeat": 5 },
      "expectedRuleId": "google-api-key"
    },
    {
      "id": "aws-access-key",
      "lineTemplate": "AWS_ACCESS_KEY_ID={value}",
      "value": { "prefix": "AKIA", "body": "W1X2", "repeat": 4 },
      "expectedRuleId": "aws-access-key-id"
    },
    {
      "id": "private-key-marker",
      "lineTemplate": "{value}",
      "value": {
        "prefix": "-----BEGIN ",
        "body": "PRIVATE KEY-----",
        "repeat": 1
      },
      "expectedRuleId": "private-key-material"
    },
    {
      "id": "encrypted-private-key-marker",
      "lineTemplate": "{value}",
      "value": {
        "prefix": "-----BEGIN ",
        "body": "ENCRYPTED PRIVATE KEY-----",
        "repeat": 1
      },
      "expectedRuleId": "private-key-material"
    },
    {
      "id": "generic-entropy",
      "lineTemplate": "client_secret=\"{value}\"",
      "value": { "prefix": "", "body": "Y3z4A5b6C7d8E9f0", "repeat": 2 },
      "expectedRuleId": "generic-high-entropy-secret"
    },
    {
      "id": "generic-refresh-token",
      "lineTemplate": "refresh_token={value}",
      "value": { "prefix": "", "body": "G1h2J3k4L5m6N7p8", "repeat": 2 },
      "expectedRuleId": "generic-high-entropy-secret"
    },
    {
      "id": "placeholder",
      "lineTemplate": "client_secret=\"{value}\"",
      "value": { "prefix": "example-", "body": "placeholder", "repeat": 2 },
      "expectedRuleId": null
    },
    {
      "id": "semantic-placeholder",
      "lineTemplate": "signing_key=\"{value}\"",
      "value": { "prefix": "signing-key-", "body": "material", "repeat": 1 },
      "expectedRuleId": null
    },
    {
      "id": "low-entropy",
      "lineTemplate": "password=\"{value}\"",
      "value": { "prefix": "", "body": "a", "repeat": 32 },
      "expectedRuleId": null
    },
    {
      "id": "environment-reference",
      "lineTemplate": "auth_token={value}",
      "value": {
        "prefix": "${",
        "body": "AUTH_TOKEN",
        "repeat": 1,
        "suffix": "}"
      },
      "expectedRuleId": null
    },
    {
      "id": "public-key-marker",
      "lineTemplate": "{value}",
      "value": {
        "prefix": "-----BEGIN ",
        "body": "PUBLIC KEY-----",
        "repeat": 1
      },
      "expectedRuleId": null
    }
  ]
}
