{
  "schemaVersion": "1.0",
  "name": "reachable-git-secret-history",
  "description": "Model-free corpus proving detection, redaction, and revision deduplication for credentials deleted from the working tree.",
  "thresholds": {
    "precision": 1,
    "recall": 1,
    "falsePositives": 0,
    "falseNegatives": 0
  },
  "cases": [
    {
      "id": "deleted-github-token",
      "path": "config/retired-github.env",
      "expected": "candidate",
      "ruleId": "github-token",
      "prefix": "GITHUB_TOKEN=\"",
      "fragments": ["ghp_", "R7qM2vN9xK4sD8fH3jL6cB5wT1yU0aP2eZ7Q"],
      "suffix": "\"\n"
    },
    {
      "id": "deleted-generic-refresh-token",
      "path": "config/retired-refresh.env",
      "expected": "candidate",
      "ruleId": "generic-high-entropy-secret",
      "prefix": "refresh_token=\"",
      "fragments": ["Q8wE2rT7", "yU4iO9pA", "5sD6fG3h"],
      "suffix": "\"\n"
    },
    {
      "id": "deduplicated-gitlab-token",
      "path": "config/retired-gitlab.env",
      "expected": "candidate",
      "ruleId": "gitlab-token",
      "prefix": "GITLAB_TOKEN=\"",
      "fragments": ["glpat-", "V8mQ2xN7kR4sT9yP6dF3wB1z"],
      "suffix": "\"\n",
      "minimumHistoryObjects": 2
    },
    {
      "id": "placeholder-control",
      "path": "config/placeholder.env",
      "expected": "no_candidate",
      "prefix": "refresh_token=\"",
      "fragments": ["fixture_", "placeholder_", "credential_123456789"],
      "suffix": "\"\n"
    },
    {
      "id": "public-key-control",
      "path": "config/public-key.pem",
      "expected": "no_candidate",
      "prefix": "-----BEGIN ",
      "fragments": ["PUBLIC", " KEY-----"],
      "suffix": "\nYWJjZA==\n-----END PUBLIC KEY-----\n"
    }
  ]
}
