    {
      "id": "traefik-directory-toml-replacepathregex-auth-bypass",
      "description": "Traefik 3.7.6 merges TOML routers, YAML middlewares, and a TOML service from one mounted file-provider directory.",
      "fixture": "fixtures/traefik-directory-toml-replacepathregex-auth-bypass",
