<Window x:Class="Secwest.CopilotSecurity.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copilot Security" Width="1320" Height="860" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="C O P I L O T   S E C U R I T Y" Foreground="{StaticResource AccentBrush}"
                   FontSize="13" FontWeight="Bold" />
        <TextBlock Text="Code security scanner" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Evidence-based discovery, validation, attack-path analysis, and reproducible benchmarking"
                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="{Binding CurrentStage}" HorizontalAlignment="Right"
                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Elapsed}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
      <TabItem Header="New scan">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" Padding="16">
          <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <GroupBox Header="Target">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Repository" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="2" Content="Browse…" Click="BrowseRepository_Click" />
                  <TextBlock Grid.Row="1" Text="Target" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TargetKinds}" SelectedItem="{Binding TargetKind}" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="2" Text="Base revision" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BaseRevision}" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="3" Text="Head revision" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HeadRevision}" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="4" Text="Scoped paths" VerticalAlignment="Top" Margin="0,11,0,0" />
                  <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding IncludePaths}"
                           Margin="0,8,0,0" MinHeight="56" AcceptsReturn="True"
                           ToolTip="Optional repository-relative paths, separated by new lines or semicolons." />
                </Grid>
              </GroupBox>

              <GroupBox Header="Analysis">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Mode" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" />
                  <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ModelSuggestions}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                            IsEditable="True" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="2" Text="Reasoning effort" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="3" Text="Authentication" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthMode}" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="4" Text="Knowledge bases" VerticalAlignment="Top" Margin="0,11,0,0" />
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding KnowledgeBasePaths}" Margin="0,8,0,0"
                           MinHeight="56" AcceptsReturn="True" ToolTip="Optional files or directories, separated by new lines or semicolons." />
                </Grid>
              </GroupBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <GroupBox Header="Safety bounds (optional)">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <TextBlock Text="Maximum cost (USD)" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding MaximumCost}" ToolTip="Leave blank for no cost ceiling." />
                  <TextBlock Grid.Row="1" Text="Maximum AI credits" VerticalAlignment="Center" Margin="0,8,0,0" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaximumCredits}" Margin="0,8,0,0"
                           ToolTip="Leave blank for no credit ceiling. This does not infer account limits." />
                </Grid>
              </GroupBox>

              <GroupBox Header="Private runtime">
                <StackPanel>
                  <TextBlock Text="All GUI scan history and scanner state remain beneath:" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Text="{Binding RuntimeHome}" TextWrapping="Wrap" Margin="0,6,0,10" FontFamily="Consolas" />
                  <Button Content="Change state root…" Click="BrowseStateRoot_Click" HorizontalAlignment="Left" />
                </StackPanel>
              </GroupBox>

              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel>
                  <TextBlock Text="Execution contract" FontWeight="SemiBold" FontSize="16"
                             Foreground="{StaticResource TextBrush}" />
                  <TextBlock TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{StaticResource MutedBrush}">
                    The GUI passes arguments without a command shell, bounds captured output, supports process-tree cancellation,
                    validates sealed artifacts before display, and keeps partial failed runs available for diagnosis without presenting them as complete.
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Content="Start scan" Command="{Binding StartScanCommand}" FontWeight="Bold"
                            Background="{StaticResource AccentBrush}" Foreground="#07110E" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Progress">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Live scanner events" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Cancel scan" Command="{Binding CancelCommand}" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding ProgressItems}" AutoGenerateColumns="False" IsReadOnly="True"
                    Background="#0C1118" Foreground="{StaticResource TextBrush}" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90" />
              <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="120" />
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Findings">
        <Grid Margin="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
          <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" AutoGenerateColumns="False"
                    IsReadOnly="True" Background="#0C1118" Foreground="{StaticResource TextBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
              <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90" />
              <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding SelectedFinding}">
              <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding FindingId}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,12" />
              <TextBlock Text="Summary" FontWeight="Bold" />
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,12" />
              <TextBlock Text="Locations" FontWeight="Bold" />
              <ItemsControl ItemsSource="{Binding Locations}" Margin="0,4,0,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Path}" FontFamily="Consolas" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Validation" FontWeight="Bold" />
              <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" Margin="0,4,0,12" />
              <TextBlock Text="Attack path" FontWeight="Bold" />
              <TextBlock Text="{Binding AttackPath}" TextWrapping="Wrap" Margin="0,4,0,12" />
              <TextBlock Text="Remediation" FontWeight="Bold" />
              <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap" Margin="0,4,0,12" />
              <TextBlock Text="CWE" FontWeight="Bold" />
              <ItemsControl ItemsSource="{Binding Cwes}" Margin="0,4,0,12" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Report">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button Content="Open report" Command="{Binding OpenReportCommand}" />
          </StackPanel>
          <TextBox Grid.Row="1" Text="{Binding ReportMarkdown, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="13" />
        </Grid>
      </TabItem>

      <TabItem Header="History">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" />
            <Button Content="Load selected" Command="{Binding LoadHistoryCommand}" />
            <TextBlock Text="{Binding HistoryRoot}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                    AutoGenerateColumns="False" IsReadOnly="True" Background="#0C1118" Foreground="{StaticResource TextBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt, StringFormat=g}" Width="150" />
              <DataGridTextColumn Header="Repository" Binding="{Binding Repository}" Width="*" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
              <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="110" />
              <DataGridTextColumn Header="Findings" Binding="{Binding FindingCount}" Width="80" />
              <DataGridTextColumn Header="Scan ID" Binding="{Binding ScanId}" Width="220" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Benchmark">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Manifest" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding BenchmarkManifest}" />
          <Button Grid.Column="2" Content="Browse…" Click="BrowseBenchmarkManifest_Click" />
          <TextBlock Grid.Row="1" Text="Results directory" VerticalAlignment="Center" Margin="0,8,0,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BenchmarkResultsDirectory}" Margin="0,8,0,0" />
          <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseBenchmarkResults_Click" Margin="4,8,4,0" />
          <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,10" HorizontalAlignment="Right">
            <CheckBox Content="Require complete status" IsChecked="{Binding BenchmarkRequireStatus}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Evaluate results" Command="{Binding RunBenchmarkCommand}" Background="{StaticResource AccentBrush}" Foreground="#07110E" />
          </StackPanel>
          <GroupBox Grid.Row="3" Grid.ColumnSpan="3" Header="Compare equivalent benchmark runs" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Baseline report" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding BaselineBenchmarkReport}" />
              <Button Grid.Column="2" Content="Browse…" Click="BrowseBaselineReport_Click" />
              <TextBlock Grid.Row="1" Text="Candidate report" VerticalAlignment="Center" Margin="0,8,0,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CandidateBenchmarkReport}" Margin="0,8,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Browse…" Click="BrowseCandidateReport_Click" />
                <Button Content="Compare" Command="{Binding CompareBenchmarksCommand}" />
              </StackPanel>
            </Grid>
          </GroupBox>
          <TextBox Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding BenchmarkOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
        </Grid>
      </TabItem>

      <TabItem Header="Diagnostics &amp; settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel MaxWidth="1050">
            <GroupBox Header="Runtime paths">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Node.js executable" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding NodePath}" />
                <Button Grid.Column="2" Content="Browse…" Click="BrowseNode_Click" />
                <TextBlock Grid.Row="1" Text="Scanner entry point" VerticalAlignment="Center" Margin="0,8,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScannerEntryPoint}" Margin="0,8,0,0" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseScanner_Click" Margin="4,8,4,0" />
                <TextBlock Grid.Row="2" Text="Copilot CLI" VerticalAlignment="Center" Margin="0,8,0,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CopilotPath}" Margin="0,8,0,0" />
                <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseCopilot_Click" Margin="4,8,4,0" />
                <TextBlock Grid.Row="3" Text="Scanner state root" VerticalAlignment="Center" Margin="0,8,0,0" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StateRoot}" Margin="0,8,0,0" />
                <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Click="BrowseStateRoot_Click" Margin="4,8,4,0" />
              </Grid>
            </GroupBox>
            <GroupBox Header="Diagnostics">
              <StackPanel>
                <Button Content="Refresh diagnostics" Command="{Binding RefreshDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding DiagnosticItems}">
                  <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#0C1118" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="10,6" Margin="0,12,0,0">
      <Grid>
        <TextBlock Text="{Binding Status}" />
        <TextBlock Text="Scanner state is isolated under copilot-security-home" HorizontalAlignment="Right"
                   Foreground="{StaticResource MutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
