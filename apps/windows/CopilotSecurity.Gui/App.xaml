<Application x:Class="Secwest.CopilotSecurity.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#10151D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#17202B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#344355" />
    <SolidColorBrush x:Key="AccentBrush" Color="#46D1A6" />
    <SolidColorBrush x:Key="TextBrush" Color="#EDF3F8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9B7C6" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0C1118" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#10151D" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="MinHeight" Value="29" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#10151D" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#10151D" />
      <Setter Property="Padding" Value="14,7" />
    </Style>
  </Application.Resources>
</Application>
